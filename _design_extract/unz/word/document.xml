fice/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="3F0B3CA6" w14:textId="2B1FAE34" w:rsidR="00591AF3" w:rsidRDefault="00591AF3" w:rsidP="00E264CF"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>囚知</w:t></w:r></w:p><w:p w14:paraId="0EDDFD15" w14:textId="770246A5" w:rsidR="00591AF3" w:rsidRDefault="00591AF3" w:rsidP="00E264CF"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>队伍成员：</w:t></w:r></w:p><w:p w14:paraId="672AE405" w14:textId="057C0533" w:rsidR="00591AF3" w:rsidRDefault="00591AF3" w:rsidP="00E264CF"><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>引擎：</w:t></w:r><w:r w:rsidR="005E35A0"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>Godot</w:t></w:r></w:p><w:p w14:paraId="6D365929" w14:textId="77777777" w:rsidR="00591AF3" w:rsidRDefault="00591AF3" w:rsidP="00591AF3"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5FF96705" w14:textId="77777777" w:rsidR="00E264CF" w:rsidRPr="00E264CF" w:rsidRDefault="00591AF3" w:rsidP="00591AF3"><w:pPr><w:rPr><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr></w:pPr><w:r w:rsidRPr="00591AF3"><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:t>摘要：</w:t></w:r><w:r w:rsidR="00E264CF" w:rsidRPr="00E264CF"><w:rPr><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>《</w:t></w:r><w:r w:rsidR="00E264CF" w:rsidRPr="00E264CF"><w:rPr><w:rFonts w:hint="eastAsia"/><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>囚知</w:t></w:r><w:r w:rsidR="00E264CF" w:rsidRPr="00E264CF"><w:rPr><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>》是一款第一人称空间解谜游戏。玩家扮演一名被囚禁在双层球状牢笼中的</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00E264CF" w:rsidRPr="00E264CF"><w:rPr><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>"第四</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00E264CF" w:rsidRPr="00E264CF"><w:rPr><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>个</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00E264CF" w:rsidRPr="00E264CF"><w:rPr><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>学生"，</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00E264CF" w:rsidRPr="00E264CF"><w:rPr><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>需要在理智耗尽之前找到</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00E264CF" w:rsidRPr="00E264CF"><w:rPr><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>"门"</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00E264CF" w:rsidRPr="00E264CF"><w:rPr><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>，回到</w:t></w:r><w:r w:rsidR="00E264CF" w:rsidRPr="00E264CF"><w:rPr><w:rFonts w:hint="eastAsia"/><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>现实世界</w:t></w:r><w:r w:rsidR="00E264CF" w:rsidRPr="00E264CF"><w:rPr><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p w14:paraId="0072A1C6" w14:textId="17B6EEF2" w:rsidR="00591AF3" w:rsidRPr="00E264CF" w:rsidRDefault="00E264CF" w:rsidP="00E264CF"><w:pPr><w:ind w:firstLine="420"/><w:rPr><w:rStyle w:val="ae"/><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r w:rsidRPr="00E264CF"><w:rPr><w:i/><w:iCs/><w:spacing w:val="5"/></w:rPr><w:t>本文档分三部分：主题阐释说明世界观如何转化为机制；场景美术设计说明空间结构与视觉语言；关卡玩法设计说明核心机制、关卡结构、逐关卡设计，以及引导与难度原则。</w:t></w:r></w:p><w:p w14:paraId="38B177D2" w14:textId="7DF211FD" w:rsidR="00BC59CE" w:rsidRDefault="00591AF3" w:rsidP="00E264CF"><w:pPr><w:widowControl/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:br w:type="page"/></w:r></w:p><w:p w14:paraId="0B4E80EB" w14:textId="7AD6B593" w:rsidR="00BC59CE" w:rsidRDefault="00BC59CE" w:rsidP="00BC59CE"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">一、主题阐释                </w:t></w:r></w:p><w:p w14:paraId="5DB471BD" w14:textId="77777777" w:rsidR="00BC59CE" w:rsidRDefault="00BC59CE" w:rsidP="00BC59CE"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t xml:space="preserve">  1.1 故事前提与核心命题</w:t></w:r></w:p><w:p w14:paraId="31E342AD" w14:textId="6DF884BD" w:rsidR="009E2D87" w:rsidRPr="00F61397" w:rsidRDefault="009E2D87" w:rsidP="009E2D87"><w:pPr><w:ind w:firstLine="420"/><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr></w:pPr><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>你崇敬的导师</w:t></w:r><w:r w:rsidRPr="00F61397"><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>——老博士，</w:t></w:r><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>是当世最顶尖的空间物理学家。他一生只做一件事：把看不见的东西摆到能看见的地方。 然而到了晚年，他停下了所有观测，只反复说一句话——"</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>'真实'</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>取决于观察角度。宇宙中所有看似矛盾的事物，只是因为我们站在了错误的位置去看它。"</w:t></w:r></w:p><w:p w14:paraId="66ED1E18" w14:textId="01E764CB" w:rsidR="009E2D87" w:rsidRPr="00F61397" w:rsidRDefault="009E2D87" w:rsidP="009E2D87"><w:pPr><w:ind w:firstLine="420"/><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr></w:pPr><w:r w:rsidRPr="00F61397"><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>同行们对老博士的理论提出诸多质疑。为了证明自己的正确，</w:t></w:r><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>他</w:t></w:r><w:r w:rsidRPr="00F61397"><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>创造</w:t></w:r><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>了一座双层扭棱十二面体牢笼</w:t></w:r><w:r w:rsidRPr="00F61397"><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>，</w:t></w:r><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>把自己和三位学生一同投了进去，只留下一条规则：</w:t></w:r></w:p><w:p w14:paraId="31A87CD3" w14:textId="77777777" w:rsidR="009E2D87" w:rsidRPr="00F61397" w:rsidRDefault="009E2D87" w:rsidP="009E2D87"><w:pPr><w:jc w:val="center"/><w:rPr><w:i/><w:iCs/><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr></w:pPr><w:r w:rsidRPr="00F61397"><w:rPr><w:i/><w:iCs/><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>只有找对位置和视角的人，才能排除矛盾、走出密室。</w:t></w:r></w:p><w:p w14:paraId="2FDD530A" w14:textId="021A657C" w:rsidR="009E2D87" w:rsidRPr="00F61397" w:rsidRDefault="009E2D87" w:rsidP="007E5A8C"><w:pPr><w:ind w:firstLine="420"/><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr></w:pPr><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>牢笼里的重力会不断改向，</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>"下"</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>不再是一个固定的方向；脚下的大地可以被你亲手挪动；而那些走到你前面的人，在世界各处留下了刻痕、数字和半张图纸。它们不是系统提示，是唯一还站在你这边的东西。逃出这座牢笼，你才能免于被矛盾的视野逼疯；也只有你出去了，老师的理论才能被证明。而他本人已经不在了——他没能走出自己造的东西，只留下那句话和这座牢笼，作为给你的最后一道题。</w:t></w:r></w:p><w:p w14:paraId="58C7741C" w14:textId="75B65949" w:rsidR="009E2D87" w:rsidRPr="00F61397" w:rsidRDefault="009E2D87" w:rsidP="009E2D87"><w:pPr><w:ind w:firstLine="420"/><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr></w:pPr><w:r w:rsidRPr="00F61397"><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>老师和学长们都没能走出牢笼，</w:t></w:r><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>你是最后一位。在理智耗尽之前找到</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>"门"</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>，返回现实世界</w:t></w:r><w:r w:rsidRPr="00F61397"><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>吧</w:t></w:r><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p w14:paraId="76BE28F7" w14:textId="171158FE" w:rsidR="009E2D87" w:rsidRPr="00F61397" w:rsidRDefault="009E2D87" w:rsidP="009E2D87"><w:pPr><w:ind w:firstLine="420"/><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr></w:pPr><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>这是本作最根本的设计出发点：主题不是叙事外衣，而是玩法本身。 玩家</w:t></w:r><w:r w:rsidR="00F61397" w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>要在操作层面反复验证</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>"观察</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>角度决定</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>真实"</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00F61397" w:rsidRPr="00F61397"><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>这一主旨。“</w:t></w:r><w:r w:rsidR="00F61397" w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>有时，从与常理不同的角度去观察，才能得到真相</w:t></w:r><w:r w:rsidR="00F61397" w:rsidRPr="00F61397"><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>。”，我们将这一思考融入到玩法当中，希望能带给玩家未曾经历过的游戏体验</w:t></w:r><w:r w:rsidR="00F61397" w:rsidRPr="00F61397"><w:rPr><w:sz w:val="20"/><w:szCs w:val="21"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p w14:paraId="0C64DD3E" w14:textId="77777777" w:rsidR="00FA1367" w:rsidRPr="00F61397" w:rsidRDefault="00FA1367" w:rsidP="00BC59CE"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6E7C4C9A" w14:textId="77777777" w:rsidR="00BC59CE" w:rsidRDefault="00BC59CE" w:rsidP="00BC59CE"><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t xml:space="preserve">  1.2 主题如何变成玩法（世界观-机制映射表，现有材料直接用）</w:t></w:r></w:p><w:p w14:paraId="191C9B2C" w14:textId="7979B31C" w:rsidR="00F61397" w:rsidRDefault="00F61397" w:rsidP="00BC59CE"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:tab/></w:r></w:p><w:p w14:paraId="3193B432" w14:textId="77777777" w:rsidR="00BC59CE" w:rsidRDefault="00BC59CE" w:rsidP="00BC59CE"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t xml:space="preserve">  1.3 四个学生 = 四种失败方式 = 玩家的三种引导</w:t></w:r></w:p><w:p w14:paraId="0A74AC92" w14:textId="77777777" w:rsidR="00BC59CE" w:rsidRDefault="00BC59CE" w:rsidP="00BC59CE"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t xml:space="preserve">  1.4 为什么用</w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>"视角"</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>作为主题（本作与同类作品的分野）</w:t></w:r></w:p><w:p w14:paraId="390D1EAD" w14:textId="77777777" w:rsidR="00BC59CE" w:rsidRDefault="00BC59CE" w:rsidP="00BC59CE"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr></w:p><w:p w14:paraId="475EB12F" w14:textId="465D92DD" w:rsidR="00BC59CE" w:rsidRDefault="00BC59CE" w:rsidP="00BC59CE"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t xml:space="preserve">二、场景美术设计                 </w:t></w:r></w:p><w:p w14